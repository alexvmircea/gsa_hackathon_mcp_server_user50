# ---------------------------------------------------------------
# HR Policy Navigator — environment variables
# Copy this file to .env and fill in your values.
# ---------------------------------------------------------------

# Optional: override the eCFR base URL (default shown below).
# Useful if the URL migrates to federalregister.gov infrastructure.
# ECFR_BASE_URL=https://www.ecfr.gov

# Optional: override the Federal Register base URL.
# FEDERAL_REGISTER_BASE_URL=https://www.federalregister.gov

# Required for the find_federal_job_requirements tool.
# Obtain a free key at https://developer.usajobs.gov/apirequest/
USAJOBS_API_KEY=your_key_here
USAJOBS_USER_AGENT=your-registered-email@agency.gov
